    <element xsi:type="archimate:Requirement" name="Opinion 05/2014 on Anonymisation Techniques" id="id-e0ae3e4992a14f14986304a105e37e7d">
      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="dct:modified" value="2024-01-17"/>
      <property key="dct:title" value="Opinion 05/2014 on Anonymisation Techniques"/>
      <property key="dct:description" value="Opinion of the European Commission concluding that anonymisation techniques can provide privacy guarantees and may be used to generate efficient anonymisation processes, but only if their application is engineered appropriately – which means that the prerequisites (context) and the objective(s) of the anonymisation process must be clearly set out in order to achieve the targeted anonymisation while producing some useful data."/>
