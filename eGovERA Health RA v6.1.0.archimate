    <element xsi:type="archimate:Device" name="Reference Testing and Experimentation Facility Technology infrastructure" id="id-5d70dcda447c4b22a353a7c5f7ef461d">
      <property key="eira:concept" value="eira:ArchitectureBuildingBlock"/>
      <property key="dct:modified" value="2024-00-11"/>
      <property key="dct:type" value="egovera:ReferenceTestingAndExperimentationFacilityTechnologyInfrastructureDevice"/>
      <property key="skos:definition" value="Technologies and devices that fall under the medical imaging umbrella include: radiography (X-rays), magnetic resonance imaging (MRI), computed tomography (CT), fluoroscopy, ultrasound, echocardiography, and nuclear medicine, such as PET (positron emission tomography). For diagnostic purposes, these devices/equipments are used to provide an image of the body and obtain a correct diagnosis while determining future care. Rapid advancements in technology and changes in health-care reform require a mindful approach in order to provide the correct system for the facility’s needs."/>
