      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="dct:modified" value="2024-01-17"/>
      <property key="dct:description" value="The capability to digitally support payments . It refers to all the instruments allowing patients to pay for their treatments and retrieve information about the outcomes of care."/>
