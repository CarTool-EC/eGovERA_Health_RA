    <element xsi:type="archimate:Representation" name="RML" id="id-19077a986a374c239999c572d1864044">
      <documentation>Description: The RDF Mapping Language (RML) is a technical specification that provides a standardized approach for transforming structured data from various formats into RDF (Resource Description Framework). RML enables the mapping of data from sources such as databases, spreadsheets, or APIs to RDF, which allows for semantic integration and interoperability. It provides a flexible and extensible mapping language that defines how the source data should be transformed into RDF triples. RML supports complex mappings, allowing for data extraction, transformation, and enrichment during the conversion process. By utilizing RML, technical teams can efficiently convert diverse data sources into RDF, facilitating seamless integration and utilization of structured data within the semantic web and linked data ecosystems.

Publisher: rml.io

Source: https://rml.io/specs/rml/

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/RMLRepresentation

EIRA traceability: eira:DataRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2023-08-20

dct:identifier: http://data.europa.eu/dr8/egovera/RMLRepresentation

</documentation>
      <property key="dct:modified" value="2024-01-28"/>
      <property key="dct:publisher" value="rml.io"/>
      <property key="dct:description" value="The RDF Mapping Language (RML) is a technical specification that provides a standardized approach for transforming structured data from various formats into RDF (Resource Description Framework). RML enables the mapping of data from sources such as databases, spreadsheets, or APIs to RDF, which allows for semantic integration and interoperability. It provides a flexible and extensible mapping language that defines how the source data should be transformed into RDF triples. RML supports complex mappings, allowing for data extraction, transformation, and enrichment during the conversion process. By utilizing RML, technical teams can efficiently convert diverse data sources into RDF, facilitating seamless integration and utilization of structured data within the semantic web and linked data ecosystems."/>
      <property key="dct:source" value="https://rml.io/specs/rml/"/>
      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="eira:PURI" value="http://data.europa.eu/dr8/egovera/RMLRepresentation"/>
      <property key="dct:identifier" value="http://data.europa.eu/dr8/egovera/RMLRepresentation"/>
      <property key="eira:view" value="SV-Functional Architecture Principles"/>
      <property key="eira:view" value="Semantic view - Motivation"/>
      <property key="eira:view" value="Semantic view"/>
      <property key="eira:eifLayer" value="Semantic"/>
      <property key="eira:implementedBy" value="http://data.europa.eu/dr8/DataRepresentation"/>
    </element>
    <element xsi:type="archimate:Representation" name="RDF-S" id="id-1b7d8e3bebc042abb25d91bf880563be">
      <documentation>Description: RDF Schema provides a data-modelling vocabulary for RDF data. RDF Schema is an extension of the basic RDF vocabulary.

