    <element xsi:type="archimate:Representation" name="CSV" id="id-ebc54fe59b0c4e40aa9c4976bd19d95c">
      <documentation>Description: CSV serves as a convenient and widely adopted data representation method due to its simplicity and compatibility with various applications and programming languages. It allows data to be easily imported, exported, and exchanged between different systems, making it a popular choice for data interchange. By using CSV as a data representation method, one can efficiently represent structured information such as database records, spreadsheets, and tables in a human-readable and machine-readable format. It provides a standardized and flexible approach to store and transmit data, enabling seamless integration and interoperability among different software and platforms.

Publisher: IETF

Source: https://www.rfc-editor.org/rfc/rfc4180

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/CSVRepresentation

EIRA traceability: eira:DataRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2023-08-20

dct:identifier: http://data.europa.eu/dr8/egovera/CSVRepresentation

</documentation>
      <property key="dct:modified" value="2024-01-28"/>
      <property key="dct:publisher" value="IETF"/>
      <property key="dct:description" value="CSV serves as a convenient and widely adopted data representation method due to its simplicity and compatibility with various applications and programming languages. It allows data to be easily imported, exported, and exchanged between different systems, making it a popular choice for data interchange. By using CSV as a data representation method, one can efficiently represent structured information such as database records, spreadsheets, and tables in a human-readable and machine-readable format. It provides a standardized and flexible approach to store and transmit data, enabling seamless integration and interoperability among different software and platforms."/>
      <property key="dct:source" value="https://www.rfc-editor.org/rfc/rfc4180"/>
      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="eira:PURI" value="http://data.europa.eu/dr8/egovera/CSVRepresentation"/>
      <property key="dct:identifier" value="http://data.europa.eu/dr8/egovera/CSVRepresentation"/>
      <property key="eira:view" value="SV-Functional Architecture Principles"/>
      <property key="eira:view" value="Semantic view - Motivation"/>
      <property key="eira:view" value="Semantic view"/>
      <property key="eira:eifLayer" value="Semantic"/>
      <property key="eira:implementedBy" value="http://data.europa.eu/dr8/DataRepresentation"/>
    </element>
    <element xsi:type="archimate:Representation" name="ISO 8601" id="id-ef07f5ea59de42ea8d8ec8b67ae4c5a3">
      <documentation>Description: ISO 8601 is an international standard that specifies the representation of dates, times, and durations. It provides a standardized format for expressing and exchanging date and time-related information in a universally accepted way. The ISO 8601 format follows the YYYY-MM-DD (year-month-day) pattern for dates and the HH:MM:SS (hour-minute-second) pattern for times. It also allows for additional elements such as time zone offsets and durations. ISO 8601 ensures consistency and interoperability in date and time representations, facilitating accurate data exchange, international communication, and proper handling of date and time-related operations across different systems and applications.

Publisher: ISO

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/ISO8601Representation

EIRA traceability: eira:DataRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2023-08-20

dct:identifier: http://data.europa.eu/dr8/egovera/ISO8601Representation

</documentation>
