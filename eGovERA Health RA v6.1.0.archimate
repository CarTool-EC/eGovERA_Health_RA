Title: Proposal for a REGULATION OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL LAYING DOWN HARMONISED RULES ON ARTIFICIAL INTELLIGENCE (ARTIFICIAL INTELLIGENCE ACT) AND AMENDING CERTAIN UNION LEGISLATIVE ACTS

</documentation>
      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="dct:modified" value="2024-01-17"/>
      <property key="dct:identifier" value="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A52021PC0206"/>
      <property key="dct:title" value="Proposal for a REGULATION OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL LAYING DOWN HARMONISED RULES ON ARTIFICIAL INTELLIGENCE (ARTIFICIAL INTELLIGENCE ACT) AND AMENDING CERTAIN UNION LEGISLATIVE ACTS"/>
      <property key="dct:publisher" value="EUR-Lex"/>
      <property key="dct:source" value="https://eur-lex.europa.eu/procedure/EN/2021_106"/>
      <property key="eira:view" value="LV-Architecture Principles"/>
      <property key="eira:view" value="LV-Binding Power and Jurisdiction"/>
      <property key="dct:description" value="The European Artificial Intelligence Act is a proposed regulation by the European Union aiming to govern the use of artificial intelligence (AI) within its member states. It classifies AI applications into different risk categories, with the highest-risk applications subject to strict obligations before they can be put on the market, including requirements for transparency, human oversight, and robustness. The Act also prohibits certain AI practices deemed unacceptable, like those that manipulate human behavior to cause harm or exploit vulnerable groups. Additionally, it sets out fines for non-compliance and establishes national authorities to oversee the regulation's implementation. This Act represents one of the most comprehensive legal frameworks for AI globally, aiming to ensure that AI systems are safe, transparent, and respect fundamental rights."/>
      <property key="eira:eifLayer" value="Legal"/>
      <property key="eira:implementedBy" value="http://data.europa.eu/dr8/BindingInstrumentRequirement"/>
    </element>
