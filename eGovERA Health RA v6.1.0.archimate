      <property key="dct:identifier" value="http://data.europa.eu/eli/reg/2018/1724/oj"/>
      <property key="dct:title" value="Regulation (EU) 2018/1724 of the European Parliament and of the Council of 2 October 2018 establishing a single digital gateway to provide access to information, to procedures and to assistance and problem-solving services and amending Regulation (EU) No 1024/2012 (Text with EEA relevance.)"/>
      <property key="dct:description" value="Regulation (EU) 2018/1724, also known as the Single Digital Gateway Regulation, aims to establish a unified digital gateway that provides easy access to information, procedures, and assistance services for citizens and businesses across the European Union. The regulation seeks to simplify and streamline the process of accessing public services and information online, making it more user-friendly and efficient. It also amends the existing Regulation (EU) No 1024/2012 to align with the new provisions. The Single Digital Gateway is an important step towards creating a more digital and interconnected Europe."/>
      <property key="dct:publisher" value="EUR-Lex"/>
      <property key="dct:source" value="http://data.europa.eu/eli/reg/2018/1724/oj"/>
      <property key="eira:view" value="LV-Architecture Principles"/>
      <property key="eira:view" value="LV-Binding Power and Jurisdiction"/>
      <property key="eira:eifLayer" value="Legal"/>
      <property key="eira:implementedBy" value="http://data.europa.eu/dr8/BindingInstrumentRequirement"/>
    </element>
    <element xsi:type="archimate:Requirement" name="Strengthened Code of Practice on Disinformation" id="id-42106a7d1e174dc5a3c777689ef489b2">
      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="dct:modified" value="2024-01-17"/>
      <property key="dct:title" value="2022 Strengthened Code of Practice on Disinformation"/>
      <property key="dct:description" value="The Strengthened Code of Practice on Disinformation is an updated version of the code that aims to combat the spread of false information online. Introduced in 2022, it includes stricter guidelines for tech companies and social media platforms to tackle disinformation effectively. The code emphasizes the need for transparency, accountability, and cooperation between platforms, governments, and fact-checking organizations. It encourages platforms to take proactive measures to identify and remove disinformation, promote reliable sources, and limit the reach of misleading content. The strengthened code also promotes user empowerment by providing tools to report and flag false information. Overall, it seeks to create a safer and more trustworthy online environment by addressing the challenges posed by disinformation."/>
      <property key="dct:source" value="https://digital-strategy.ec.europa.eu/en/library/2022-strengthened-code-practice-disinformation"/>
      <property key="dct:identifier" value="https://digital-strategy.ec.europa.eu/en/library/2022-strengthened-code-practice-disinformation"/>
      <property key="eira:view" value="LV-Architecture Principles"/>
      <property key="eira:view" value="LV-Binding Power and Jurisdiction"/>
      <property key="eira:eifLayer" value="Legal"/>
      <property key="eira:implementedBy" value="http://data.europa.eu/dr8/Non-bindingInstrumentRequirement"/>
    </element>
