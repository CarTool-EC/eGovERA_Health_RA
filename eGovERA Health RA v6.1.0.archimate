      <property key="dct:modified" value="2023-11-20"/>
      <property key="dct:identifier" value="http://data.europa.eu/dr8/egovera/DataCatalogueManagementApplicationService"/>
      <property key="dct:title" value="Data Catalogue Management Application Service"/>
      <property key="dct:type" value="egovera:DataCatalogueManagementApplicationService"/>
