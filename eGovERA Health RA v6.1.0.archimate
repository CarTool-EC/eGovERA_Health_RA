dct:identifier: http://data.europa.eu/dr8/egovera/CodeOfConductForEnergyEfficiencyInDataCentresContract

dct:title: Code of Conduct for Energy Efficiency in Data Centres

</documentation>
      <property key="eira:PURI" value="http://data.europa.eu/dr8/egovera/CodeOfConductForEnergyEfficiencyInDataCentresContract"/>
      <property key="dct:modified" value="2024-01-28"/>
      <property key="dct:description" value="This voluntary code of conduct was developed by the European Commission's Joint Research Centre to improve the energy efficiency and environmental sustainability of data centers. It provides guidelines and best practices for data center operators to reduce their environmental impact."/>
      <property key="skos:example" value="A data centre operator could conduct an energy audit to identify areas where energy is being wasted. For example, they might find that their servers are using more power than necessary during off-peak hours. Based on these findings, they could create an Action Plan to reduce energy usage, such as implementing server virtualization to consolidate workloads and reduce the number of physical servers needed, or using energy-efficient cooling systems."/>
      <property key="skos:note" value="The European Code of Conduct for Data Centres is a voluntary initiative managed by the Joint Research Centre (JRC), the European Commission’s science and knowledge service. It primarily addresses data centre owners and operators, and secondly the supply chain and service providers. The Code of Conduct aims to reduce energy consumption in data centres in a cost-effective manner without hampering their critical function."/>
      <property key="eira:concept" value="eira:SolutionBuildingBlock"/>
      <property key="dct:identifier" value="http://data.europa.eu/dr8/egovera/CodeOfConductForEnergyEfficiencyInDataCentresContract"/>
