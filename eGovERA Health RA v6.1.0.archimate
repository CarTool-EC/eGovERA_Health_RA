            <child xsi:type="archimate:DiagramObject" id="id-61fd38963cbf41a28eb0223c4d2802ca" targetConnections="id-195f6d207d514cfb998954d2a67bd591" textPosition="1" archimateElement="id-bc3d50f4c8694eab84aef35de8928981" type="1">
