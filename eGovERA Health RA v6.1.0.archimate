      <property key="dct:publisher" value="Joint Research Centre"/>
      <property key="dct:source" value="https://joint-research-centre.ec.europa.eu/scientific-activities-z/energy-efficiency/energy-efficiency-products/code-conduct-ict/code-conduct-energy-efficiency-data-centres_en"/>
