    <element xsi:type="archimate:ApplicationComponent" name="Once-Only Technical System" id="id-72c4718c6207480a95c6cc74e47c383e">
      <documentation>Description: The Once Only Technical System (OOTS) enables the sharing of information between public administrations across borders between EU countries. It is cross-sectorial and can be expanded beyond the current scope of life events set out in the Single Digital Gateway Regulation. It puts into practice the Once-Only Principle, which states that citizens should not be forced to provide information to authorities if another authority already holds that information in electronic format.

Publisher: European Commission

Source: https://ec.europa.eu/digital-building-blocks/wikis/display/DIGITAL/Once+Only+Technical+System

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/Once-OnlyTechnicalSystemApplicationService

LOST view: TVA-Data Exchange Enablers [Motivation]

EIRA concept: eira:SolutionBuildingBlock

Additional identifier: http://data.europa.eu/dr8/egovera/Once-OnlyTechnicalSystemApplicationService

Title: eDelivery

Realises: http://data.europa.eu/dr8/PublicAdministrationSingleWindowApplicationComponent

</documentation>
      <property key="eira:PURI" value="http://data.europa.eu/dr8/egovera/Once-OnlyTechnicalSystemApplicationService"/>
      <property key="dct:identifier" value="http://data.europa.eu/dr8/egovera/Once-OnlyTechnicalSystemApplicationService"/>
      <property key="dct:title" value="eDelivery"/>
      <property key="dct:type"/>
      <property key="dct:publisher" value="European Commission"/>
      <property key="dct:description" value="The Once Only Technical System (OOTS) enables the sharing of information between public administrations across borders between EU countries. It is cross-sectorial and can be expanded beyond the current scope of life events set out in the Single Digital Gateway Regulation. It puts into practice the Once-Only Principle, which states that citizens should not be forced to provide information to authorities if another authority already holds that information in electronic format."/>
      <property key="dct:source" value="https://ec.europa.eu/digital-building-blocks/wikis/display/DIGITAL/Once+Only+Technical+System"/>
      <property key="dct:modified" value="2024-01-28"/>
