                <bounds x="360" y="120" width="144" height="72"/>
                <sourceConnection xsi:type="archimate:Connection" id="id-049f76d66a4649df9e0e174a518eeecb" source="id-a7768ce37dd24ecfa94dfd227dacef00" target="id-7f248dce1e584822893978887cf9a645" archimateRelationship="id-93b44904f90a4a1a9018c80b81b2c435"/>
